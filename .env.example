# Local Clipper configuration.
#
# scripts/setup.sh copies this file to .env (only if .env does not exist yet). Edit .env, not
# this file. .env is git-ignored; never commit it or paste its contents anywhere.
# Commented lines show the built-in default; uncomment a line to change it.
# Check the result with: scripts/doctor.sh

# ---------------------------------------------------------------------------- OpenAI
# Required to analyse videos (transcription + clip selection). Create a key at
# https://platform.openai.com/api-keys and paste it after the "=" (no quotes, no spaces).
# The key stays on this computer: it is never sent to the browser or written to logs.
OPENAI_API_KEY=

# Models (see docs/MODELS.md before changing; prices and capabilities differ).
# CLIPPER_TRANSCRIBE_MODEL=whisper-1
# CLIPPER_SELECT_MODEL=gpt-6.1-sol
# CLIPPER_REVIEW_MODEL=gpt-6.1-sol
# Reasoning effort: low | medium | high | xhigh | max (gpt-6.1-sol has no "none"/"minimal").
# CLIPPER_SELECT_REASONING_EFFORT=low
# CLIPPER_REVIEW_REASONING_EFFORT=low
# CLIPPER_SELECT_MAX_OUTPUT_TOKENS=32000
# CLIPPER_REVIEW_MAX_OUTPUT_TOKENS=32000
# CLIPPER_OPENAI_TIMEOUT_SECONDS=300
# CLIPPER_OPENAI_MAX_RETRIES=3
# Transcription chunking (each request must stay under OpenAI's 25 MB upload limit).
# CLIPPER_TRANSCRIBE_CHUNK_SECONDS=600
# CLIPPER_TRANSCRIBE_OVERLAP_SECONDS=3
# CLIPPER_TRANSCRIBE_AUDIO_FORMAT=flac

# ---------------------------------------------------------------------------- Mode & network
# local = runs on this computer; hosted = server deployment behind HTTPS (see DEPLOYMENT.md).
CLIPPER_MODE=local
# Keep 127.0.0.1 so only this computer can reach the app. Binding another address requires
# sign-in (CLIPPER_AUTH=required plus the password hash and session secret below).
CLIPPER_HOST=127.0.0.1
CLIPPER_PORT=8765
# Address the browser uses. Default: http://<CLIPPER_HOST>:<CLIPPER_PORT>
# CLIPPER_PUBLIC_ORIGIN=http://127.0.0.1:8765
# Extra accepted Host names / browser origins, comma separated (e.g. the Vite dev server).
# CLIPPER_ALLOWED_HOSTS=
# CLIPPER_ALLOWED_ORIGINS=http://localhost:5173
# Proxy addresses (IPs/CIDRs, comma separated) allowed to tell the app the visitor's address in
# X-Forwarded-For, so sign-in throttling counts each visitor separately. Leave empty when only this
# computer uses the app. Set it to 127.0.0.1 when a reverse proxy or tunnel on this computer forwards
# a public hostname (in CLIPPER_PUBLIC_ORIGIN or CLIPPER_ALLOWED_HOSTS) to the app: otherwise every
# visitor appears as 127.0.0.1 and CLIPPER_LOGIN_MAX_FAILURES wrong passwords from anyone lock you
# out too (scripts/doctor.sh warns). The proxy must set or append the visitor's address in
# X-Forwarded-For. Hosted mode: see deploy/env.hosted.example.
# CLIPPER_TRUSTED_PROXIES=

# ---------------------------------------------------------------------------- Sign-in
# auto = no sign-in in local mode while everything is loopback-only (CLIPPER_HOST, CLIPPER_PUBLIC_ORIGIN,
#        CLIPPER_ALLOWED_HOSTS and CLIPPER_ALLOWED_ORIGINS all name 127.0.0.1 / localhost / ::1);
#        any other name (e.g. a proxy or tunnel hostname) turns sign-in on (behind a proxy or
#        tunnel on this computer, also set CLIPPER_TRUSTED_PROXIES=127.0.0.1 above);
# required = always ask for the owner password;
# disabled = never ask (refused at startup unless all of the above are loopback, and never in hosted mode).
CLIPPER_AUTH=auto
# CLIPPER_OWNER_USERNAME=owner
# Needed whenever sign-in is on. Generate the hash with scripts/hash-password.sh and keep the
# single quotes (the hash contains $ signs):
# CLIPPER_OWNER_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$...'
# At least 32 random characters, e.g. from: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# CLIPPER_SESSION_SECRET=
# CLIPPER_SESSION_TTL_HOURS=12
# CLIPPER_SESSION_IDLE_MINUTES=120
# auto = Secure cookies when the public origin is https:// or in hosted mode.
# CLIPPER_COOKIE_SECURE=auto
# CLIPPER_LOGIN_MAX_FAILURES=5
# CLIPPER_LOGIN_WINDOW_SECONDS=900

# ---------------------------------------------------------------------------- Storage
# Where projects, media, the database and logs live. Default: <repository>/data
# Use a local disk (not a network share or a synced cloud folder).
# Stop Local Clipper (scripts/stop.sh) before changing it: the scripts find the running app
# through files in this folder.
# CLIPPER_DATA_DIR=/absolute/path/to/data
# Built web interface. Default: <repository>/frontend/dist
# CLIPPER_FRONTEND_DIST=/absolute/path/to/frontend/dist
# Jobs refuse to start when less than this much disk space would remain.
# CLIPPER_MIN_FREE_DISK_MB=1024

# ---------------------------------------------------------------------------- Limits & defaults
# CLIPPER_MAX_SOURCE_MINUTES=120
# CLIPPER_MAX_UPLOAD_MB=4096
# CLIPPER_MAX_CLIPS=10
# CLIPPER_DEFAULT_CLIP_COUNT=5
# CLIPPER_DEFAULT_MIN_SECONDS=20
# CLIPPER_DEFAULT_MAX_SECONDS=60

# ---------------------------------------------------------------------------- Media tools
# Program names or absolute paths.
# CLIPPER_FFMPEG=ffmpeg
# CLIPPER_FFPROBE=ffprobe
# JavaScript runtime yt-dlp uses for YouTube (deno 2.3 or newer), optionally deno:/path/to/deno
# CLIPPER_YTDLP_JS_RUNTIME=deno
# auto = use the Mac's hardware H.264 encoder if it passes a real test encode; off = always CPU.
# CLIPPER_HW_ENCODE=auto
# CPU (libx264) encoder settings.
# CLIPPER_RENDER_PRESET=veryfast
# CLIPPER_RENDER_CRF=20

# ---------------------------------------------------------------------------- Logging
# CLIPPER_LOG_LEVEL=INFO
