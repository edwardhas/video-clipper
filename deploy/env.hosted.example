# Hosted (server) configuration for deploy/compose.yaml. See DEPLOYMENT.md.
#
#   cp deploy/env.hosted.example deploy/.env.hosted && chmod 600 deploy/.env.hosted
#
# deploy/.env.hosted is git-ignored and holds secrets: never commit or share it.
# Keep values unquoted unless noted; single quotes keep $ signs literal (needed for the hash).
# The placeholders below are deliberately invalid so the app refuses to start until filled in.

# ---------------------------------------------------------------------------- Mode & addresses
CLIPPER_MODE=hosted
# Interface inside the container only. The api container's port is never published; only the
# Caddy proxy publishes ports 80/443 on the host.
CLIPPER_HOST=0.0.0.0
# Port the api listens on inside its container. compose.yaml passes this same value to Caddy
# (reverse_proxy api:{$CLIPPER_PORT}), so change it only here.
CLIPPER_PORT=8765
# EXAMPLE hostname - configurable, not chosen yet. Must be the exact https:// origin users open.
CLIPPER_PUBLIC_ORIGIN=https://clipper.example.com
# Hostname Caddy obtains the TLS certificate for (same host as CLIPPER_PUBLIC_ORIGIN).
CLIPPER_HOSTNAME=clipper.example.com
# Address of the Caddy container on the compose "internal" network (CLIPPER_PROXY_IP below,
# default 172.30.57.10 in compose.yaml).
CLIPPER_TRUSTED_PROXIES=172.30.57.10
# Only if 172.30.57.0/24 collides with an existing network on the host (keep all three in sync):
# CLIPPER_PROXY_SUBNET=172.30.57.0/24
# CLIPPER_PROXY_IP=172.30.57.10

# ---------------------------------------------------------------------------- Storage & limits
CLIPPER_DATA_DIR=/data
# Also used by Caddy for its request body limit.
CLIPPER_MAX_UPLOAD_MB=4096
# CLIPPER_MAX_SOURCE_MINUTES=120
# CLIPPER_MIN_FREE_DISK_MB=1024

# ---------------------------------------------------------------------------- Sign-in (required)
# CLIPPER_OWNER_USERNAME=owner
# Generate with scripts/hash-password.sh (or: docker compose run --rm --no-deps api
# python -m clipper.cli hash-password) and paste it INSIDE single quotes, e.g.
# CLIPPER_OWNER_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$abc...$xyz...'
CLIPPER_OWNER_PASSWORD_HASH='REPLACE_WITH_ARGON2_HASH'
# At least 32 random characters: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out.
CLIPPER_SESSION_SECRET=

# ---------------------------------------------------------------------------- OpenAI
# Server-side only; never sent to browsers or logged.
OPENAI_API_KEY=
